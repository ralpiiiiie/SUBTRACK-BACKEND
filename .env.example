# App
APP_NAME="Subscription Tracker API"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-api.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

# Logging (Render captures stdout/stderr)
LOG_CHANNEL=stderr
LOG_LEVEL=error

# Database (Neon PostgreSQL)
# On Render: set DATABASE_URL to your Neon pooled connection string.
# (e.g. postgresql://user:pass@ep-xxx.aws.neon.tech/neondb?sslmode=require)
DB_CONNECTION=pgsql
DATABASE_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=subtrack
DB_USERNAME=postgres
DB_PASSWORD=
DB_SSLMODE=require

# Sessions & Cookies
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=none
SESSION_HTTP_ONLY=true

# CORS & Sanctum
# FRONTEND_URL: Comma-separated list of allowed origins (e.g. https://your-app.vercel.app)
FRONTEND_URL=https://your-app.vercel.app
# SANCTUM_STATEFUL_DOMAINS: Comma-separated domains without protocol (e.g. your-app.vercel.app)
SANCTUM_STATEFUL_DOMAINS=your-app.vercel.app

# Cache & Queues
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail (optional)
MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"